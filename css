:root{
  --bg:#081421;
  --card:#11263d;
  --text:#eaf2ff;
  --muted:#a8bdd8;
  --accent:#21c7a8;
}
*{box-sizing:border-box}
body{
  margin:0;
  font-family:system-ui,sans-serif;
  background:linear-gradient(180deg,#06111c,#0b1b2c);
  color:var(--text);
}
.app{max-width:980px;margin:0 auto;padding:20px}
.hero{padding:20px 0 10px}
.hero h1{margin:0 0 8px;font-size:2rem}
.hero p{margin:0;color:var(--muted)}
.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
  gap:16px;
  margin-top:20px;
}
.card{
  background:rgba(17,38,61,.92);
  border:1px solid rgba(255,255,255,.08);
  border-radius:18px;
  padding:16px;
}
.card h2{margin-top:0}
button{
  border:0;
  background:var(--accent);
  color:#062018;
  padding:10px 14px;
  border-radius:12px;
  cursor:pointer;
  font-weight:700;
  margin-top:8px;
}
input[type="text"], input[type="file"]{
  width:100%;
  padding:10px;
  border-radius:12px;
  border:1px solid rgba(255,255,255,.12);
  background:#0a1726;
  color:var(--text);
}
ul{list-style:none;padding:0;margin:12px 0 0}
li{
  padding:10px;
  margin-bottom:8px;
  background:#0a1726;
  border-radius:10px;
  color:var(--muted);
}
.tips{margin-top:10px;color:var(--muted);line-height:1.7}
